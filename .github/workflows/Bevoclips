<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital@0;1&family=Lato:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#050505;--fg:#f2f2f2;--mute:#a9a9a9;--card:#141414;--line:#2b2b2b;--accent:#f7d417;--accent-text:#f7d417;--ink:#050505;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#fafafa;--fg:#121212;--mute:#555;--card:#fff;--line:#ddd;--accent-text:#7a6200;color-scheme:light}}
:root[data-theme="dark"]{--bg:#050505;--fg:#f2f2f2;--mute:#a9a9a9;--card:#141414;--line:#2b2b2b;--accent-text:#f7d417}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:400 17px/1.65 Lato,system-ui,sans-serif}
h1,h2,h3{font-family:"Libre Baskerville",Georgia,serif;font-weight:400;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
section{padding:84px 0}
h2{font-size:clamp(28px,5vw,40px);color:var(--accent-text);margin-bottom:28px}
.btn{display:inline-block;background:var(--accent);color:var(--ink);font-weight:700;text-decoration:none;padding:14px 28px;border-radius:999px}
.btn.ghost{background:none;color:var(--fg);border:1.5px solid var(--line)}
header.top{display:flex;justify-content:space-between;align-items:center;padding:22px 0}
.logo{font-weight:700;letter-spacing:.28em;text-decoration:none}
nav a{margin-left:20px;text-decoration:none;color:var(--mute);font-size:15px}
nav a:hover{color:var(--fg)}
.hero{display:grid;grid-template-columns:1.25fr 1fr;gap:40px;align-items:center;padding:56px 0 90px}
.hero h1{font-style:italic;font-size:clamp(46px,9vw,92px);line-height:1.02;color:var(--accent-text)}
.hero p{max-width:30em;margin:24px 0 32px;font-size:19px}
.tc{font:13px/1 ui-monospace,Menlo,monospace;color:var(--mute);margin-bottom:18px;font-variant-numeric:tabular-nums}
.tc i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#e5372e;margin-right:8px}
.portrait{width:100%;max-width:340px;justify-self:center;aspect-ratio:3/4;object-fit:cover;border-radius:170px 170px 14px 14px;border:3px solid var(--accent)}
.about{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.about p{margin:0 0 16px;max-width:36em}
.facts{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.facts li{border-left:3px solid var(--accent);padding:4px 0 4px 16px}
.facts b{display:block;font-family:"Libre Baskerville",Georgia,serif;font-weight:400}
.facts span{color:var(--mute);font-size:15px}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.svc{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px}
.svc h3{font-size:19px;margin-bottom:8px}
.svc p{margin:0;color:var(--mute);font-size:15px;line-height:1.55}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:22px}
.proj{display:block;text-decoration:none;background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.poster{position:relative;aspect-ratio:16/9;display:grid;place-items:center;background:linear-gradient(135deg,#1c1c1c,#0a0a0a);color:#f2f2f2;font:italic 22px "Libre Baskerville",Georgia,serif;text-align:center;padding:12px}
.proj.vert .poster{aspect-ratio:16/9}
.play{position:absolute;right:14px;bottom:14px;width:46px;height:46px;border-radius:50%;background:var(--accent);display:grid;place-items:center}
.play::after{content:"";border-left:14px solid var(--ink);border-top:9px solid transparent;border-bottom:9px solid transparent;margin-left:4px}
a.proj:hover .play{transform:scale(1.1)}
.proj.soon .play{background:var(--line)}
.proj.soon .play::after{border-left-color:var(--mute)}
.meta{padding:16px 18px 20px}
.meta h3{font-size:17px;margin-bottom:4px}
.meta p{margin:0;color:var(--mute);font-size:14.5px;line-height:1.5}
.tag{display:inline-block;margin-top:10px;font-size:13px;color:var(--accent-text);border:1px solid var(--line);border-radius:999px;padding:2px 10px}
.quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
blockquote{margin:0;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:26px}
blockquote p{margin:0 0 16px;font:italic 18px/1.55 "Libre Baskerville",Georgia,serif}
blockquote footer{color:var(--mute);font-size:14.5px}
.certs{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}
.certs figure{margin:0}
.certs img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid var(--line)}
.certs figcaption{margin-top:10px;font-size:15px;display:flex;justify-content:space-between;gap:12px}
.certs span{color:var(--mute);white-space:nowrap}
.contact h2{color:var(--fg);max-width:14em;font-size:clamp(30px,6vw,52px);line-height:1.2}
.links{display:grid;gap:14px;margin:30px 0 0;max-width:420px}
.links a{display:flex;align-items:center;gap:14px;text-decoration:none}
.ic{flex:none;width:44px;height:44px;border-radius:50%;background:var(--accent);display:grid;place-items:center}
.ic svg{width:20px;height:20px;fill:var(--ink)}
.links small{display:block;color:var(--mute);line-height:1.2}
footer.end{border-top:1px solid var(--line);padding:26px 0;color:var(--mute);font-size:14px}
@media (max-width:760px){.hero,.about{grid-template-columns:1fr}.portrait{max-width:260px;justify-self:start;grid-row:1}nav{display:none}section{padding:60px 0}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}a.proj:hover .play{transform:none}}
dialog.player{border:0;padding:0;background:#000;color:#fff;width:min(960px,94vw);border-radius:14px;overflow:hidden}
dialog.player::backdrop{background:rgba(0,0,0,.88)}
.pbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 14px;font-size:14px}
.pbar a{color:#cfcfcf}
.pbar button{background:var(--accent);color:#050505;border:0;border-radius:999px;font:700 14px Lato,sans-serif;padding:8px 18px;cursor:pointer}
.vwrap{aspect-ratio:16/9;background:#000}
.vwrap iframe{width:100%;height:100%;border:0;display:block}
.rv{opacity:0;transform:translateY(14px);transition:opacity .6s ease,transform .6s ease}.rv.in{opacity:1;transform:none}
.cta-row{display:flex;gap:12px;flex-wrap:wrap}
.btn.big{padding:16px 32px;font-size:18px;box-shadow:0 8px 28px rgba(247,212,23,.22)}
.trust{margin:22px 0 0;color:var(--mute);font-size:14.5px}
.navcta{padding:9px 20px;margin-left:22px;color:var(--ink)!important}
.sub{margin:-14px 0 26px;color:var(--mute)}
.th{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
a.proj{transition:transform .25s ease,border-color .25s}
a.proj:hover{transform:translateY(-3px);border-color:var(--accent)}
.band{margin-top:44px;padding:34px 26px;border:1px solid var(--line);border-radius:16px;background:var(--card);text-align:center}
.band p{margin:0 0 18px;font:italic 22px "Libre Baskerville",Georgia,serif}
.band .cta-row{justify-content:center}
.whygrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.why{padding:22px;border-top:3px solid var(--accent);background:var(--card);border-radius:0 0 12px 12px}
.why b{font:400 18px "Libre Baskerville",Georgia,serif;display:block;margin-bottom:6px}
.why span{color:var(--mute);font-size:15px;line-height:1.55}
.sticky{display:none}
@media (max-width:760px){.sticky{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:5;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));background:var(--bg);border-top:1px solid var(--line)}.sticky .btn{flex:1;text-align:center;padding:13px 10px}body{padding-bottom:76px}.navcta{display:none}}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}a.proj:hover{transform:none}}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 76px)}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:4;background:var(--bg)}
@media (max-width:760px){html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 100px)}header.top{flex-direction:column;align-items:flex-start;gap:4px;padding:12px 0 8px}nav{display:flex;gap:20px;overflow-x:auto;width:100%;white-space:nowrap}nav a{margin:0}}
blockquote details{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
blockquote summary{cursor:pointer;color:var(--accent-text);font-size:14.5px}
blockquote details img{display:block;width:100%;height:auto;margin-top:12px;border-radius:10px;border:1px solid var(--line)}
.shot{display:block;width:100%;height:auto;margin-top:16px;border-radius:10px;border:1px solid var(--line)}
dialog.player.tall{width:min(400px,94vw,42vh)}
.vwrap.vert{aspect-ratio:9/16}
</style>
</head>
